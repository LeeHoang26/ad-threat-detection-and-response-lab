<Sysmon schemaversion="4.90">

  <!-- Add executable hashes to supported process events. -->
  <HashAlgorithms>SHA256</HashAlgorithms>

  <!-- Check signatures for revoked certificates. -->
  <CheckRevocation/>

  <EventFiltering>

    <!-- Include: Any write to canary trap files -->
    <RuleGroup name="Canary_FileCreate_Include" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">!_financial_payroll_2026</TargetFilename>
        <TargetFilename condition="contains">!_confidential_contract</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Record process starts so the handler can verify ProcessGuid and creation time. -->
    <RuleGroup name="Process_Create_For_Response_Check" groupRelation="or">
      <ProcessCreate onmatch="exclude" />
    </RuleGroup>

  </EventFiltering>
</Sysmon>
